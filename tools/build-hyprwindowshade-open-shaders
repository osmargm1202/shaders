#!/usr/bin/env bash
# Generate the HyprWindowShade GLSL ES transition catalogue from the Niri sources.
set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
output_link="${1:-$repo_root/hyprwindowshade/open}"
output_parent="$(dirname -- "$output_link")"
release_root="$output_parent/releases"

command -v glslangValidator >/dev/null || {
  printf '%s\n' 'glslangValidator is required to generate HyprWindowShade shaders' >&2
  exit 1
}

mkdir -p "$release_root"
staging_dir="$(mktemp -d "$release_root/.release.XXXXXX")"
link_candidate=
backup_dir=
activated=false

cleanup() {
  rm -rf "${staging_dir:-}"
  rm -f "${link_candidate:-}"
  if [ "$activated" != true ] && [ -n "${backup_dir:-}" ] && [ ! -e "$output_link" ]; then
    mv -T "$backup_dir" "$output_link"
  fi
}
trap cleanup EXIT HUP INT TERM

for source in "$repo_root"/*/open.glsl; do
  [ -f "$source" ] || continue
  name="$(basename "$(dirname "$source")")"

  # The retained Niri source is syntactically incomplete. Keep it usable by
  # Niri, but do not publish an invalid HyprWindowShade artifact.
  if [ "$name" = 'glass-warp' ]; then
    continue
  fi

  destination="$staging_dir/$name.glsl"
  {
    cat <<'GLSL'
#version 320 es
// Generated from the Niri source in osmargm1202/shaders.
// See niri-shaders-LICENSE for the retained MIT license and attribution.
precision highp float;

in vec2 v_texcoord;
out vec4 fragColor;

uniform sampler2D tex;
uniform float transition_progress;
uniform float transition_seed;
uniform vec2 surface_size;

#define niri_clamped_progress clamp(transition_progress, 0.0, 1.0)
#define niri_random_seed transition_seed
#define niri_geo_to_tex mat3(1.0)
#define niri_tex tex
#define texture2D texture
GLSL
    cat "$source"
    cat <<'GLSL'

void main() {
  fragColor = open_color(vec3(v_texcoord, 1.0), vec3(surface_size, 1.0));
}
GLSL
  } >"$destination"

  glslangValidator -S frag "$destination"
done

install -Dm644 "$repo_root/LICENSE" "$staging_dir/niri-shaders-LICENSE"
release_id="$(sha256sum "$staging_dir"/* | sha256sum | cut -c1-16)"
release_dir="$release_root/$release_id"

if [ -e "$release_dir" ]; then
  rm -rf "$staging_dir"
else
  mv -T "$staging_dir" "$release_dir"
fi
staging_dir=

# `open` is a stable symlink. Replacing it in one directory is atomic after
# the one-time migration from an older checked-in directory.
if [ -d "$output_link" ] && [ ! -L "$output_link" ]; then
  backup_dir="$output_parent/.open-legacy.$$"
  mv -T "$output_link" "$backup_dir"
fi
link_candidate="$(mktemp "$output_parent/.open.link.XXXXXX")"
rm -f "$link_candidate"
ln -s "releases/$release_id" "$link_candidate"
mv -Tf "$link_candidate" "$output_link"
link_candidate=
activated=true
rm -rf "${backup_dir:-}"
backup_dir=
trap - EXIT HUP INT TERM
